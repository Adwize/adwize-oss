# Database (used by Docker Compose)
DB_PASSWORD=changeme
DB_NAME=adwize
DB_USER=postgres

# Optional: API key for authenticating requests.
# If set, all API requests must include X-Api-Key header.
# If unset, no authentication is required (localhost-friendly).
# API_KEY=

# Optional: Default webhook URL for alert notifications.
# Can also be configured per-rule via the API.
# WEBHOOK_URL=https://hooks.slack.com/services/...
